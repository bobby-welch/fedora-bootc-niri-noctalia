# Installer-only ISO (Anaconda). Same pinned base as ../Containerfile;
# Renovate bumps both pins together.
FROM quay.io/fedora/fedora-bootc:45@sha256:32efabff97ea5062b9c1f20fafc519038f6165017a140cb6c3b96469ba69a86e

# Anaconda plus the tools image-builder runs inside this container.
RUN dnf5 install -y \
      anaconda \
      anaconda-install-img-deps \
      anaconda-dracut \
      dracut-config-generic \
      dracut-network \
      net-tools \
      grub2-efi-x64-cdboot \
      plymouth \
      default-fonts-core-sans \
      default-fonts-other-sans \
      google-noto-sans-cjk-fonts \
      xorrisofs \
      squashfs-tools \
      jq \
    && dnf5 clean all

# image-builder takes shim and grub from /boot/efi.
RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

COPY iso.yaml /usr/lib/image-builder/bootc/iso.yaml
COPY interactive-defaults.ks /usr/share/anaconda/interactive-defaults.ks

# What lorax normally does: boot straight into Anaconda.
RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd \
    && echo "install::14438:0:99999:7:::" >> /etc/shadow \
    && passwd -d root

# Permissive, not disabled: bootc needs SELinux on to label the target,
# and selinux=0 on the ISO's command line leaks into the installed system.
RUN sed -i 's/^SELINUX=.*/SELINUX=permissive/' /etc/selinux/config \
    && grep -qx 'SELINUX=permissive' /etc/selinux/config

# Anaconda reads product details from /.buildstamp, which lorax normally
# writes; without IsFinal=True it warns that it's pre-release software.
RUN printf '%s\n' '[Main]' 'Product=Fedora' "Version=$(rpm -E %fedora)" 'IsFinal=True' \
      "UUID=$(date -u +%Y%m%d%H%M).$(uname -m)" \
      'BugURL=https://github.com/bobby-welch/fedora-bootc-niri-noctalia/issues' \
      > /.buildstamp

RUN mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives \
    && mv /usr/share/dnf5/repos.d /etc/anaconda.repos.d \
    && ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target \
    && rm -v /usr/lib/systemd/system-generators/systemd-gpt-auto-generator

RUN ln -s /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service

RUN mkdir -p /usr/lib/systemd/logind.conf.d
COPY <<EOT /usr/lib/systemd/logind.conf.d/anaconda-shell.conf
[Login]
ReserveVT=2
EOT

RUN mkdir -p "$(realpath /root)" \
    && kernel=$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version') \
    && DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
         --add anaconda "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"

# Anaconda runs as root, and PipeWire refuses root by default.
RUN mkdir -p /etc/systemd/user/pipewire.service.d /etc/systemd/user/pipewire.socket.d
COPY <<EOT /etc/systemd/user/pipewire.service.d/allowroot.conf
[Unit]
ConditionUser=
EOT
COPY <<EOT /etc/systemd/user/pipewire.socket.d/allowroot.conf
[Unit]
ConditionUser=
EOT
